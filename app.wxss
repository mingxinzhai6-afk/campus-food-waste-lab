/* ============================================================
   一餐之后 · 手绘主题（横版）
   纸感卡片 + 珊瑚橙/草绿/钢蓝/麦芽棕 + 软蓝天空底
   ============================================================ */
page {
  --ink: #2f4256;
  --muted: #7d8f9e;
  --faint: #9aabbb;
  --paper: #fffdf8;
  --surface: #f5f0e8;
  --sky: #d9e9f6;
  --grid-line: #e2ebf4;
  --orange: #e0763c;
  --orange-dark: #c26130;
  --green: #58a87a;
  --blue: #4a86c8;
  --brown: #b98a63;
  --wheat: #d8b45e;
  --r-card: 16px 9px 14px 10px / 10px 14px 9px 16px;
  --r-mid: 12px 7px 10px 8px / 8px 10px 7px 12px;
  --r-btn: 10px 6px 9px 7px / 7px 9px 6px 10px;
  background: linear-gradient(180deg, #d9e9f6 0%, #e6f1fa 55%, #eef5fb 100%);
  background-attachment: fixed;
  font-size: 13px;
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  height: 100%;
}

/* ---- 页面骨架：手机竖屏为默认（底部导航条），宽屏 / 横屏回到左侧导航栏 ---- */
.main {
  margin-left: 0;
  padding: 12px 14px calc(74px + env(safe-area-inset-bottom));
  max-width: none;
}
.page-title {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  margin: 4px 0 12px;
  flex-wrap: wrap;
}
.page-title h1 {
  font-size: 23px;
  line-height: 1.22;
  margin: 2px 0 4px;
  font-weight: 800;
}
.page-title h1 em {
  font-style: normal;
  color: var(--orange);
}
.page-title .muted {
  margin: 0;
}
.eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  color: var(--muted);
}
.head-label-lg {
  color: var(--orange-dark);
}
.muted {
  color: var(--muted);
  font-size: 12px;
}

/* ---- 纸感卡片 ---- */
.panel {
  background: var(--paper);
  border: 2px solid #35506b;
  border-radius: var(--r-card);
  box-shadow: 0 5px 0 -1px rgba(60, 85, 112, 0.14);
  padding: 14px 16px;
}
.panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 8px;
}
.panel-heading h2 {
  font-size: 15px;
  margin: 1px 0 0;
  font-weight: 800;
}
.panel-h2 {
  font-size: 15px;
  font-weight: 800;
  margin-top: 1px;
}
.kicker {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 1.5px;
  color: var(--orange-dark);
}
.step {
  font-size: 10.5px;
  font-weight: 700;
  color: var(--paper);
  background: var(--blue);
  border-radius: var(--r-btn);
  padding: 3px 8px;
  white-space: nowrap;
}

/* ---- 按钮 ---- */
.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: var(--orange);
  color: #fff;
  border: 2px solid #35506b;
  border-radius: var(--r-btn);
  box-shadow: 0 4px 0 -1px rgba(60, 85, 112, 0.35);
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.2;
}
.primary-button:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 -1px rgba(60, 85, 112, 0.35);
}
.primary-button.disabled,
.primary-button[disabled] {
  opacity: 0.45;
}
.quiet-button,
.outline-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  background: var(--paper);
  color: var(--ink);
  border: 2px solid #35506b;
  border-radius: var(--r-btn);
  box-shadow: 0 3px 0 -1px rgba(60, 85, 112, 0.22);
  padding: 7px 12px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
}
.quiet-button:active,
.outline-button:active {
  transform: translateY(2px);
  box-shadow: 0 1px 0 -1px rgba(60, 85, 112, 0.22);
}
.text-button {
  font-size: 11.5px;
  color: var(--blue);
  font-weight: 700;
  padding: 4px 2px;
}

/* ---- 双栏布局：手机竖屏单列；宽屏 / 横屏双栏 ---- */
.two-col {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  align-items: start;
}
.two-col.even {
  grid-template-columns: 1fr;
}

/* ---- ≥731px：启用左侧导航栏与内容留白（按系统安全区避让刘海） ---- */
@media (min-width: 731px) {
  .main {
    margin-left: calc(150px + var(--safe-left, 0px));
    padding: 10px 20px 34px;
    padding-right: calc(20px + var(--safe-right, 0px));
    max-width: 1180px;
  }
  /* 宽屏标题栏恢复单行（手机端才需要换行） */
  .page-title {
    flex-wrap: nowrap;
  }
}

/* ---- ≥951px：才启用双栏。手机横屏（一般 700–900 逻辑宽）保持单列，
        否则右栏会被挤成一条（打卡页出现过"连续打卡"竖排） ---- */
@media (min-width: 951px) {
  .two-col {
    grid-template-columns: 11fr 9fr;
  }
  .two-col.even {
    grid-template-columns: 1fr 1fr;
  }
}

/* ---- 手绘环形（conic-gradient） ---- */
.ring {
  position: relative;
  border-radius: 50%;
  border: 2px solid #35506b;
}
.ring-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: var(--paper);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.ring-hole b {
  font-size: 17px;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.1;
}
.ring-hole .hole-cap {
  font-size: 9.5px;
  color: var(--muted);
  margin-top: 1px;
}

/* ---- 小标签 / 提示 ---- */
.field-hint {
  font-size: 11px;
  color: var(--muted);
  font-weight: 400;
  margin-left: 6px;
}
.method-note {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  background: rgba(255, 253, 248, 0.85);
  border: 2px dashed #b9cbdc;
  border-radius: var(--r-mid);
  padding: 8px 12px;
  margin-top: 12px;
}
.method-note span {
  flex: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 2px solid var(--blue);
  color: var(--blue);
  font-size: 10px;
  font-weight: 800;
  text-align: center;
  line-height: 13px;
  margin-top: 1px;
}
.method-note p,
.method-note .note-p {
  margin: 0;
  font-size: 11px;
  color: var(--muted);
  line-height: 1.55;
}

/* ---- 影响卡（影响页与打卡页共用） ---- */
.impact-card {
  background: var(--paper);
  border: 2px solid #35506b;
  border-radius: var(--r-card);
  box-shadow: 0 5px 0 -1px rgba(60, 85, 112, 0.14);
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-top-width: 5px;
}
.impact-card.green { border-top-color: #58a87a; }
.impact-card.blue { border-top-color: #4a86c8; }
.impact-card.orange { border-top-color: #e0763c; }
.impact-card.ink { border-top-color: #b98a63; }
.card-label {
  font-size: 11px;
  color: var(--muted);
  font-weight: 700;
}
.card-value b {
  font-size: 22px;
  font-weight: 800;
}
.card-unit {
  font-size: 10.5px;
  color: var(--faint);
  margin-left: 3px;
}
.small-note {
  font-size: 10.5px;
  color: var(--faint);
  margin: 6px 0 0;
  line-height: 1.5;
}

/* ---- 结果带（下一步） ---- */
.result-band {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  background: linear-gradient(120deg, #fdf3e7, #fdf8ee);
  border: 2px solid #35506b;
  border-radius: var(--r-card);
  box-shadow: 0 5px 0 -1px rgba(60, 85, 112, 0.14);
  padding: 14px 18px;
  margin-top: 14px;
}
.result-band h2 {
  font-size: 16px;
  margin: 2px 0 3px;
  font-weight: 800;
}
.result-band p {
  margin: 0;
  font-size: 12px;
  color: var(--muted);
}

/* ---- 通用 chip ---- */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.chip {
  background: var(--paper);
  border: 2px solid #b9cbdc;
  border-radius: var(--r-btn);
  padding: 4px 10px;
  font-size: 11.5px;
  color: var(--muted);
  font-weight: 600;
}
.chip.on {
  border-color: var(--orange);
  color: var(--orange-dark);
  background: #fdf1e8;
}

/* ---- 表格 ---- */
.viz-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11.5px;
}
.viz-table th {
  text-align: left;
  color: var(--muted);
  font-size: 10.5px;
  font-weight: 700;
  padding: 4px 8px;
  border-bottom: 2px solid #c9d9e9;
  white-space: nowrap;
}
.viz-table td {
  padding: 6px 8px;
  border-bottom: 1.5px dashed #e2ebf4;
  vertical-align: middle;
}
.viz-table td small {
  display: block;
  color: var(--faint);
  font-size: 10px;
}

/* ---- 数值条 ---- */
.bar-track {
  position: relative;
  height: 8px;
  background: #eef3f8;
  border-radius: 6px;
  overflow: hidden;
  border: 1.5px solid #d5e2ee;
}
.bar-track i {
  display: block;
  height: 100%;
  background: var(--blue);
  border-radius: 6px;
}
.bar-track i.after {
  background: var(--green);
}
.bar-track i.orange {
  background: var(--orange);
}

/* ---- 淡入动画 ---- */
@keyframes sketch-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.sketch-in {
  animation: sketch-in 0.45s ease forwards;
}
@keyframes float-y {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-3px);
  }
}


/* 矮屏（横屏高度 <= 480px）：压缩页头留白，避免"头顶一大片空白" */
@media (max-height: 480px) {
  .main {
    padding-top: 2px;
  }
  .page-title {
    margin: 0 0 4px;
    gap: 8px;
  }
  .page-title .muted {
    font-size: 11px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 1.4px;
  }
}
